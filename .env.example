# Copy this file to .env and adjust values for your setup.
# The Makefile sources .env automatically if it exists.

# ── ESP32 ────────────────────────────────────────────────────────────────────
IDF_PATH=~/esp/esp-idf
IDF_TAG=v5.4.1
ESP_PORT=                        # leave empty for auto-detect

# ── Server ───────────────────────────────────────────────────────────────────
ADMIN_TOKEN=changeme
PUF_THRESHOLD_PCT=10.0
LISTEN_ADDR=:8080
DATABASE_URL=postgres://puf:puf@localhost:5432/pufdb

# ── Docker ───────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=puf
