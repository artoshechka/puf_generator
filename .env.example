# Скопируй файл в .env и подстрой значения под своё окружение.
# Makefile автоматически подтягивает .env, если он есть.

# ── ESP32 ────────────────────────────────────────────────────────────────────
IDF_PATH=~/esp/esp-idf
IDF_TAG=v5.4.1
ESP_PORT=                        # оставь пустым для авто-определения

# ── Сервер ───────────────────────────────────────────────────────────────────
ADMIN_TOKEN=replace-me
PUF_THRESHOLD_PCT=10.0
LISTEN_ADDR=:8080
DATABASE_URL=postgres://puf:puf@localhost:5432/pufdb
POSTGRES_PASSWORD=puf

# ── Docker ───────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=puf
